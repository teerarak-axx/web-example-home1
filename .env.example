# Absolute path recommended on a VPS; keep this outside release folders.
STORAGE_DIR=./storage
SITE_URL=http://localhost:3000
# Set a strong initial password BEFORE first production startup (12+ characters).
# Development only: defaults to admin1234.
ADMIN_INITIAL_PASSWORD=
# Enable only behind HTTPS reverse proxy; required for production login.
COOKIE_SECURE=false
# Set true ONLY if the proxy overwrites X-Forwarded-For from client IP.
TRUST_PROXY=false
